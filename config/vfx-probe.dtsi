/*
 * Temporary diagnostic: sweeps one physical LED at a time (white) so the
 * real strip order can be read off by eye, plus three solid color checks.
 *
 * Not for permanent use - delete this file and its #include once the real
 * key-pixels / pixel-positions tables are built from what it reveals.
 */

#include <dt-bindings/zmk/vfx.h>

/ {
    vfx_probe_zones {
        vfx_probe_00_zone: vfx_probe_00_zone {
            compatible = "zmk,vfx-zone";
            range = <0 1>;
