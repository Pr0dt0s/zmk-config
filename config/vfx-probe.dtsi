/*
 * Temporary diagnostics.
 *
 * The per-key order is settled, so the sweep is down to the six underglow
 * pixels, whose order in the chain is still unknown. They sit on the glow
 * channel, so stepping that channel walks them one at a time.
 *
 * Delete this file, its two #includes and the probe scenes in the channel
 * lists once the underglow order is known.
 */

#include <dt-bindings/zmk/vfx.h>

/ {
    vfx_probe_zones {
        vfx_probe_00_zone: vfx_probe_00_zone {
            compatible = "zmk,vfx-zone";
            range = <0 1>;
        };
        vfx_probe_01_zone: vfx_probe_01_zone {
            compatible = "zmk,vfx-zone";
            range = <1 1>;
        };
        vfx_probe_02_zone: vfx_probe_02_zone {
            compatible = "zmk,vfx-zone";
            range = <2 1>;
        };
        vfx_probe_03_zone: vfx_probe_03_zone {
            compatible = "zmk,vfx-zone";
            range = <3 1>;
        };
        vfx_probe_04_zone: vfx_probe_04_zone {
            compatible = "zmk,vfx-zone";
            range = <4 1>;
        };
        vfx_probe_05_zone: vfx_probe_05_zone {
            compatible = "zmk,vfx-zone";
            range = <5 1>;
        };
    };

    vfx_probes {
        vfx_probe_00: vfx_probe_00 {
            compatible = "zmk,vfx-scene";
            display-name = "Probe 00";

            px {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_probe_00_zone>;
                color = <VFX_HSB(0, 0, 100)>;
            };
        };
        vfx_probe_01: vfx_probe_01 {
            compatible = "zmk,vfx-scene";
            display-name = "Probe 01";

            px {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_probe_01_zone>;
                color = <VFX_HSB(0, 0, 100)>;
            };
        };
        vfx_probe_02: vfx_probe_02 {
            compatible = "zmk,vfx-scene";
            display-name = "Probe 02";

            px {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_probe_02_zone>;
                color = <VFX_HSB(0, 0, 100)>;
            };
        };
        vfx_probe_03: vfx_probe_03 {
            compatible = "zmk,vfx-scene";
            display-name = "Probe 03";

            px {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_probe_03_zone>;
                color = <VFX_HSB(0, 0, 100)>;
            };
        };
        vfx_probe_04: vfx_probe_04 {
            compatible = "zmk,vfx-scene";
            display-name = "Probe 04";

            px {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_probe_04_zone>;
                color = <VFX_HSB(0, 0, 100)>;
            };
        };
        vfx_probe_05: vfx_probe_05 {
            compatible = "zmk,vfx-scene";
            display-name = "Probe 05";

            px {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_probe_05_zone>;
                color = <VFX_HSB(0, 0, 100)>;
            };
        };
    };

    vfx_color_zones {
        vfx_bar_numbers_zone: vfx_bar_numbers_zone {
            compatible = "zmk,vfx-zone";
            range = <6 6>;
        };

        vfx_bar_qwerty_zone: vfx_bar_qwerty_zone {
            compatible = "zmk,vfx-zone";
            range = <12 6>;
        };

        vfx_bar_home_zone: vfx_bar_home_zone {
            compatible = "zmk,vfx-zone";
            range = <18 6>;
        };
    };

    vfx_color_tests {
        /* Red on the number row, green on QWERTY, blue on home. Reset the hue
         * first or this lies, since a stored shift rotates all three equally.
         */
        vfx_color_bars: vfx_color_bars {
            compatible = "zmk,vfx-scene";
            display-name = "Colour Bars";

            numbers {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_bar_numbers_zone>;
                color = <VFX_HSB(0, 100, 100)>;
            };

            qwerty {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_bar_qwerty_zone>;
                color = <VFX_HSB(120, 100, 100)>;
            };

            home {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_bar_home_zone>;
                color = <VFX_HSB(240, 100, 100)>;
            };
        };
    };
};
